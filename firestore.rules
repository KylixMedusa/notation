rules_version = '2';

// One shared, open, collaborative library: anyone may read/write/delete songs.
// "Open" is guarded by shape + size validation (and, in production, Firebase App Check)
// to keep humans in and spam scripts out — there are no user accounts.
service cloud.firestore {
  match /databases/{database}/documents {

    function validSong(d) {
      return d.title is string
        && d.title.size() <= 200
        && d.sections is list
        && d.sections.size() <= 200
        && d.tags is list
        && d.updatedAt is number;
    }

    match /songs/{songId} {
      allow read: if true;
      allow delete: if true;
      allow create, update: if validSong(request.resource.data);
    }
  }
}
