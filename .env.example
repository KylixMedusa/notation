# Copy to .env.local and fill in. .env.local is git-ignored.

# ── Firebase web config (Project settings → Web app). Not secret; identifies the project. ──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# reCAPTCHA v3 site key for Firebase App Check (optional until going public).
VITE_APPCHECK_KEY=

# "true" → use local Firestore emulator; "false" → real project.
VITE_USE_FIRESTORE_EMULATOR=false

# ── AI screenshot import — SERVER-SIDE only (used by api/extract-chart.ts). Never exposed to the client. ──
# OpenAI-compatible LLM gateway base URL + key.
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Model id the gateway routes to (e.g. a vision-capable model).
NOTATION_AI_MODEL=sonnet-4.5
# Shared passphrase that gates the AI import endpoint.
AI_IMPORT_PASSPHRASE=
